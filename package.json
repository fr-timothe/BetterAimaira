{
	"name": "betteraimaira",
	"version": "0.1.1-beta.11",
	"description": "Alternative Tauri client for Aimaira student intranets.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent",
		"check": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"desktop:dev": "tauri dev --features dev-automation",
		"mobile:dev": "tauri dev -c src-tauri/tauri.mobile-dev.conf.json --features dev-automation",
		"dev:desktop": "tauri dev --features dev-automation",
		"dev:mobile": "tauri dev -c src-tauri/tauri.mobile-dev.conf.json --features dev-automation",
		"android:sync": "bun ./scripts/sync-android-assets.mjs",
		"android:dev": "bun run android:sync && tauri android dev",
		"ios:dev": "tauri ios dev",
		"desktop:build": "tauri build",
		"desktop:build:export": "tauri build && bun ./scripts/clean-build.mjs --export",
		"updater:keygen": "bun ./scripts/updater-keygen.mjs",
		"android:version-code": "bun ./scripts/android-version-code.mjs",
		"release:manifest": "bun ./scripts/release-manifest.mjs",
		"release:notes": "bun ./scripts/release-notes.mjs",
		"release:tag": "bun ./scripts/release-tag.mjs",
		"perf:report": "bun ./scripts/performance-report.mjs",
		"clean": "bun ./scripts/clean-build.mjs --all",
		"clean:cache": "bun ./scripts/clean-build.mjs --intermediate",
		"tauri": "tauri"
	},
	"license": "GPL-3.0-only",
	"dependencies": {
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^2.24.1",
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/kit": "^2.9.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.2.0",
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.6.2",
		"vite": "^6.0.3"
	}
}
