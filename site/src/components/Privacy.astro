---
// The one ink field on the page. Trust is the section the whole product rests
// on, so it gets a whole colour region rather than four tinted cards. Secondary
// text on ink is tinted from the brand hue (`--primary-soft`), never grey.
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { useContent, type Lang } from '../i18n/content';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useContent(lang);
const icons: IconName[] = ['cloud-off', 'key-round', 'lock-keyhole', 'eye'];
---

<section id="privacy" class="scroll-mt-24 bg-secondary text-secondary-foreground">
	<div class="mx-auto w-full max-w-[76rem] px-5 py-20 sm:px-8 sm:py-28">
		<div class="max-w-[46rem]">
			<Icon name="shield-check" class="size-8 text-primary" />
			<h2 class="mt-5 text-3xl font-heavy tracking-[-0.02em] sm:text-4xl lg:text-5xl">{t.privacy.title}</h2>
			<p class="mt-5 max-w-[56ch] text-lg leading-relaxed text-primary-soft">{t.privacy.lead}</p>
		</div>

		<dl class="mt-14 grid gap-x-12 gap-y-10 sm:grid-cols-2">
			{
				t.privacy.items.map((item, index) => (
					<div >
						<dt class="flex items-center gap-2.5 text-lg font-bold">
							<Icon name={icons[index]!} class="size-5 shrink-0 text-primary" />
							{item.title}
						</dt>
						<dd class="mt-3 max-w-[52ch] text-md leading-relaxed text-primary-soft">{item.body}</dd>
					</div>
				))
			}
		</dl>

		<figure class="mt-16 rounded-xl bg-primary px-6 py-8 sm:px-10 sm:py-10">
			<blockquote class="text-2xl font-heavy tracking-[-0.02em] text-primary-foreground sm:text-3xl">
				{t.privacy.quote}
			</blockquote>
			<figcaption class="mt-4 max-w-[68ch] text-md leading-relaxed text-primary-foreground">
				{t.privacy.quoteBody}
			</figcaption>
		</figure>
	</div>
</section>
