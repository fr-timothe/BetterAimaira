---
// Five platforms with their real availability. A row per platform, separated by
// hairlines, in the same grammar as the strengths section — not five same-size
// cards, which is the lazy container and which left an orphan two-card row at
// three columns. The badge names the availability, so the status is never
// carried by colour alone.
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { localePath, useContent, type Lang, type PlatformId } from '../i18n/content';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useContent(lang);

const icons: Record<PlatformId, IconName> = {
	windows: 'monitor',
	macos: 'laptop',
	linux: 'terminal',
	android: 'smartphone',
	ios: 'apple',
};
---

<section class="mx-auto w-full max-w-[76rem] px-5 py-20 sm:px-8 sm:py-28">
	<div class="max-w-[44rem]">
		<h2 class="text-3xl font-heavy tracking-[-0.02em] text-foreground sm:text-4xl">{t.platforms.title}</h2>
		<p class="mt-4 text-lg leading-relaxed text-muted-foreground">{t.platforms.lead}</p>
	</div>

	<ul class="mt-12 border-t border-border-subtle">
		{
			t.platforms.items.map((platform) => (
				<li class="flex flex-wrap items-center gap-x-5 gap-y-2 border-b border-border-subtle py-5">
					<Icon name={icons[platform.id]} class="size-6 shrink-0 text-primary-deep" />
					<h3 class="shrink-0 text-lg font-bold text-foreground sm:w-32">{platform.name}</h3>
					<p class="min-w-0 flex-1 basis-full text-md leading-relaxed text-muted-foreground sm:basis-auto">
						{platform.detail}
					</p>
					{platform.availability === 'release' ? (
						<span class="inline-flex shrink-0 items-center gap-1.5 rounded-pill bg-success-surface px-2.5 py-1 text-xs font-semibold text-success-strong">
							<Icon name="check" class="size-3.5" strokeWidth={2.5} />
							{t.platforms.released}
						</span>
					) : (
						<span class="inline-flex shrink-0 items-center gap-1.5 rounded-pill bg-muted px-2.5 py-1 text-xs font-semibold text-primary-deep">
							<Icon name="terminal" class="size-3.5" />
							{t.platforms.fromSource}
						</span>
					)}
				</li>
			))
		}
	</ul>

	<div class="mt-10">
		<Button href={localePath(lang, 'download')} variant="accent" size="lg" icon="arrow-right" iconTrailing>
			{t.platforms.cta}
		</Button>
	</div>
</section>
