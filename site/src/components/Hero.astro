---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { localePath, repo, useContent, type Lang } from '../i18n/content';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useContent(lang);
---

<section class="relative overflow-hidden">
	<div
		class="mx-auto grid w-full max-w-[76rem] items-center gap-14 px-5 pb-16 pt-14 sm:px-8 sm:pb-24 sm:pt-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.04fr)] lg:gap-16"
	>
		<div>
			<h1 class="arrive text-4xl font-heavy tracking-[-0.02em] text-foreground sm:text-5xl lg:text-6xl">
				{t.hero.title}
			</h1>
			<p
				class="arrive mt-6 max-w-[52ch] text-lg leading-relaxed text-muted-foreground"
				style="--arrive-delay: 90ms;"
			>
				{t.hero.lead}
			</p>

			<div class="arrive mt-9 flex flex-wrap items-center gap-3" style="--arrive-delay: 180ms;">
				<Button href={localePath(lang, 'download')} variant="ink" size="lg" icon="download">
					{t.hero.primary}
				</Button>
				<Button href={repo} variant="outline" size="lg" icon="github" external>
					{t.hero.secondary}
				</Button>
			</div>

			<p class="mt-6 flex items-center gap-2 text-md font-medium text-primary-deep">
				<Icon name="lock-keyhole" class="size-[1.125rem] shrink-0" />
				{t.hero.licence}
			</p>
			<p class="mt-2 max-w-[56ch] text-sm text-muted-foreground">{t.hero.unofficial}</p>
		</div>

		<div class="relative">
			<!-- A flat tinted field, not a glow: the ground the screenshot sits on,
			     painted in the system's own `--muted`. -->
			<div
				class="arrive absolute -inset-x-4 -bottom-8 -top-6 rounded-[2rem] bg-muted sm:-inset-x-8 lg:-right-16"
				style="--arrive-delay: 200ms;"
				aria-hidden="true"
			>
			</div>
			<figure class="arrive relative" style="--arrive-delay: 290ms;">
				<div class="device">
					<img
						src="/media/screenshot-today.png"
						alt={t.hero.screenshotAlt}
						width="1280"
						height="800"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
				<figcaption class="mt-3 text-sm text-muted-foreground">{t.demoNote}</figcaption>
			</figure>
		</div>
	</div>
</section>
