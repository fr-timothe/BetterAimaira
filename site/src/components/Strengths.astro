---
// Three columns under one heading. Deliberately not three cards: a hairline
// above each column and real space between them separates the group without a
// container, which is what keeps the section from reading as a widget shelf.
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { useContent, type Lang } from '../i18n/content';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useContent(lang);
const icons: IconName[] = ['clock', 'calendar-days', 'database'];
---

<section class="border-y border-border-subtle bg-card">
	<div class="mx-auto w-full max-w-[76rem] px-5 py-20 sm:px-8 sm:py-24">
		<h2 class="max-w-[26ch] text-3xl font-heavy tracking-[-0.02em] text-foreground sm:text-4xl">
			{t.strengths.title}
		</h2>

		<div class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
			{
				t.strengths.items.map((item, index) => (
					<div class="border-t-2 border-primary-deep pt-6">
						<Icon name={icons[index]!} class="size-6 text-primary-deep" />
						<h3 class="mt-4 text-xl font-bold leading-snug text-foreground">{item.title}</h3>
						<p class="mt-3 text-md leading-relaxed text-muted-foreground">{item.body}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
