---
// The compatibility check on the home page.
//
// It answers the one objection that stands between reading about the app and
// installing it — "does this work at my school?" — where that objection is
// raised, instead of behind a menu entry. The full directory stays on
// /ecoles; this is the shortcut to a single answer.
//
// Same rules as that page: the directory is baked in at build time, nothing is
// fetched, no query leaves the page, and every status is said in words rather
// than carried by a colour. Without JavaScript the field is a plain GET form
// that lands on the directory, so the section never becomes a dead end.
import Button from './Button.astro';
import Icon from './Icon.astro';
import schools from '../../../assets/schools/schools.json';
import {
	localePath,
	useContent,
	type Lang,
	type PortalLogin,
	type SchoolStatus,
} from '../i18n/content';

interface Props {
	lang: Lang;
}

interface School {
	id: string;
	name: string;
	category: string;
	portalUrl: string | null;
	portalLogin: PortalLogin | null;
	group?: string;
	website?: string;
}

const { lang } = Astro.props;
const t = useContent(lang);
const directory = schools as School[];

function statusOf(school: School): SchoolStatus {
	if (!school.portalUrl) return 'unknown';
	if (school.portalLogin === 'sso') return 'sso';
	if (school.portalLogin === 'email-first') return 'emailFirst';
	return 'ready';
}

/** Accent-insensitive, so `ecole` finds `École` and `spéos` finds `Speos`. */
function fold(text: string): string {
	return text
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase();
}

/** The badge tone per status. Never the only carrier — the label says it too. */
const statusTones: Record<SchoolStatus, string> = {
	ready: 'bg-success-surface text-success-strong',
	emailFirst: 'bg-muted text-primary-deep',
	sso: 'bg-danger-surface text-danger-strong',
	unknown: 'bg-surface-sunken text-muted-foreground',
};

// One compact row per school, matched in the browser: name, portal host, group,
// status, and the folded string the query is tested against. Building the
// haystack here rather than on the client keeps the first keystroke cheap.
const rows = directory.map((school) => [
	school.name,
	school.portalUrl?.replace(/^https:\/\//, '').replace(/\/$/, '') ?? '',
	school.group ?? '',
	statusOf(school),
	fold([school.name, school.group ?? '', school.id.replace(/-/g, ' '), school.portalUrl ?? ''].join(' ')),
]);

// Everything the script needs to write a verdict, resolved for this locale so
// no string is duplicated in JavaScript.
const strings = {
	status: t.schools.status,
	tones: statusTones,
	portalLabel: t.schools.portalLabel,
	groupNote: t.schools.groupNote,
	emptyBody: t.schools.emptyBody,
	sheetHref: localePath(lang, 'schools'),
};

const seeAll = t.schools.checkSeeAll.replace('{count}', String(directory.length));
---

<section id="compatibility" class="scroll-mt-24">
	<div class="mx-auto w-full max-w-[76rem] px-5 py-20 sm:px-8 sm:py-28">
		<div class="max-w-[46rem]">
			<Icon name="graduation-cap" class="size-8 text-primary-deep" />
			<h2 class="mt-5 text-3xl font-heavy tracking-[-0.02em] text-foreground sm:text-4xl">
				{t.schools.checkTitle}
			</h2>
			<p class="mt-5 max-w-[56ch] text-lg leading-relaxed text-muted-foreground">
				{t.schools.checkLead}
			</p>
		</div>

		<div data-school-check>
			<!-- A real GET form: with the script stripped out, Enter still lands the
			     visitor on the directory instead of doing nothing. -->
			<form
				class="mt-9 max-w-[34rem]"
				role="search"
				method="get"
				action={localePath(lang, 'schools')}
			>
				<label class="block text-sm font-semibold text-foreground" for="school-check">
					{t.schools.searchLabel}
				</label>

				<div class="relative mt-2">
					<div
						class="flex min-h-[3.25rem] items-center rounded-md border border-border bg-card pl-3.5 text-muted-foreground focus-within:border-primary-deep"
					>
						<Icon name="search" class="size-[1.125rem] shrink-0" />
						<input
							id="school-check"
							name="q"
							type="search"
							role="combobox"
							aria-expanded="false"
							aria-controls="school-check-list"
							aria-autocomplete="list"
							autocomplete="off"
							autocapitalize="none"
							spellcheck="false"
							placeholder={t.schools.searchPlaceholder}
							class="min-w-0 flex-1 self-stretch bg-transparent px-3 text-md text-foreground outline-0 placeholder:text-muted-foreground"
							data-check-input
						/>
						<button
							type="button"
							class="mr-1 hidden size-(--tap-min) shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors duration-fast hover:bg-muted hover:text-foreground"
							aria-label={t.schools.clear}
							data-check-clear
						>
							<Icon name="x" class="size-[1.125rem]" />
						</button>
					</div>

					<ul
						id="school-check-list"
						role="listbox"
						aria-label={t.schools.searchLabel}
						class="absolute inset-x-0 top-[calc(100%+0.5rem)] z-20 max-h-[19rem] overflow-y-auto rounded-md border border-border-subtle bg-card p-1.5 shadow-lg"
						hidden
						data-check-list
					>
					</ul>
				</div>
			</form>

			<!-- The verdict itself. Rendered here so the buttons stay the site's own
			     control primitive; the script only fills it in. -->
			<div
				class="mt-5 max-w-[34rem] rounded-lg border border-border-subtle bg-card p-5"
				aria-live="polite"
				hidden
				data-check-card
			>
				<h3 class="text-xl font-bold leading-snug text-foreground" data-check-name></h3>

				<span
					class="mt-3 inline-flex items-center rounded-pill px-2.5 py-1 text-xs font-semibold"
					data-check-badge></span>

				<p class="mt-3 text-md leading-relaxed text-muted-foreground" data-check-body></p>

				<p class="mt-4 min-w-0 text-sm" hidden data-check-portal>
					<span class="block text-xs font-semibold uppercase tracking-wide text-muted-foreground">
						{t.schools.portalLabel}
					</span>
					<span class="block break-all text-foreground" data-numeric data-check-host></span>
				</p>

				<p class="mt-3 text-sm text-muted-foreground" hidden data-check-group></p>

				<div class="mt-5 flex flex-wrap gap-3">
					<Button
						href={localePath(lang, 'download')}
						variant="accent"
						icon="download"
						data-check="download"
					>
						{t.schools.cta}
					</Button>
					<Button
						href={localePath(lang, 'schools')}
						variant="outline"
						icon="arrow-right"
						iconTrailing
						data-check="sheet"
					>
						{t.schools.checkSheet}
					</Button>
				</div>
			</div>

			<p class="mt-6 max-w-[56ch] text-sm leading-relaxed text-muted-foreground">
				{t.schools.checkHint}{' '}
				<a
					href={localePath(lang, 'schools')}
					class="font-semibold text-primary-deep no-underline hover:underline"
				>
					{seeAll}
				</a>
			</p>
		</div>
	</div>

	<script is:inline type="application/json" data-check-schools set:html={JSON.stringify(rows)} />
	<script is:inline type="application/json" data-check-strings set:html={JSON.stringify(strings)} />
</section>

<style>
	/* WebKit draws its own clear button inside a search field, next to the one
	   this section draws with a label on it. Two crosses, one job. */
	input[type='search']::-webkit-search-cancel-button {
		display: none;
	}
</style>

<script>
	// A combobox over the baked-in directory. Same matcher as the schools page —
	// accent-folded, every typed word must appear — with two additions the page
	// does not need: keyboard selection, and a verdict written out in one card
	// instead of a card left standing in a grid.
	import type { SchoolStatus } from '../i18n/content';

	type Row = [name: string, host: string, group: string, status: SchoolStatus, haystack: string];

	interface Strings {
		status: Record<SchoolStatus, { badge: string; body: string }>;
		tones: Record<SchoolStatus, string>;
		portalLabel: string;
		groupNote: string;
		emptyBody: string;
		sheetHref: string;
	}

	const root = document.querySelector<HTMLElement>('[data-school-check]');
	const schoolsData = document.querySelector<HTMLScriptElement>('[data-check-schools]');
	const stringsData = document.querySelector<HTMLScriptElement>('[data-check-strings]');

	if (root && schoolsData && stringsData) {
		const rows: Row[] = JSON.parse(schoolsData.textContent ?? '[]');
		const text: Strings = JSON.parse(stringsData.textContent ?? '{}');

		const input = root.querySelector<HTMLInputElement>('[data-check-input]')!;
		const clear = root.querySelector<HTMLButtonElement>('[data-check-clear]')!;
		const list = root.querySelector<HTMLUListElement>('[data-check-list]')!;
		const card = root.querySelector<HTMLElement>('[data-check-card]')!;
		const name = root.querySelector<HTMLElement>('[data-check-name]')!;
		const badge = root.querySelector<HTMLElement>('[data-check-badge]')!;
		const body = root.querySelector<HTMLElement>('[data-check-body]')!;
		const portal = root.querySelector<HTMLElement>('[data-check-portal]')!;
		const host = root.querySelector<HTMLElement>('[data-check-host]')!;
		const group = root.querySelector<HTMLElement>('[data-check-group]')!;
		const download = root.querySelector<HTMLAnchorElement>('[data-check="download"]')!;
		const sheet = root.querySelector<HTMLAnchorElement>('[data-check="sheet"]')!;

		/** How many suggestions fit before the list becomes a directory again. */
		const limit = 8;
		/** One letter matches a third of the list; two is where a name starts. */
		const minimum = 2;

		let active = -1;

		const fold = (value: string) =>
			value
				.normalize('NFD')
				.replace(/[̀-ͯ]/g, '')
				.toLowerCase();

		function matches(query: string): Row[] {
			const words = fold(query).split(/\s+/).filter(Boolean);
			if (!words.length) return [];
			return rows.filter((row) => words.every((word) => row[4].includes(word))).slice(0, limit);
		}

		function options() {
			return [...list.querySelectorAll<HTMLButtonElement>('[role="option"]')];
		}

		function close() {
			list.hidden = true;
			list.replaceChildren();
			active = -1;
			input.setAttribute('aria-expanded', 'false');
			input.removeAttribute('aria-activedescendant');
		}

		function move(step: number) {
			const items = options();
			if (!items.length) return;
			active = (active + step + items.length) % items.length;
			items.forEach((item, index) => {
				const selected = index === active;
				item.setAttribute('aria-selected', String(selected));
				item.classList.toggle('bg-muted', selected);
			});
			input.setAttribute('aria-activedescendant', items[active]!.id);
			items[active]!.scrollIntoView({ block: 'nearest' });
		}

		function option(row: Row, index: number): HTMLLIElement {
			const item = document.createElement('li');
			const button = document.createElement('button');
			button.type = 'button';
			button.id = `school-check-option-${index}`;
			button.setAttribute('role', 'option');
			button.setAttribute('aria-selected', 'false');
			button.className =
				'flex w-full flex-wrap items-center gap-x-3 gap-y-1 rounded-sm px-2.5 py-2 text-left hover:bg-muted';

			const label = document.createElement('span');
			label.className = 'min-w-0 flex-1 text-md font-semibold leading-snug text-foreground';
			label.textContent = row[0];

			const tone = document.createElement('span');
			tone.className = `inline-flex shrink-0 items-center rounded-pill px-2.5 py-1 text-xs font-semibold ${text.tones[row[3]]}`;
			tone.textContent = text.status[row[3]].badge;

			button.append(label, tone);
			button.addEventListener('mousedown', (event) => event.preventDefault());
			button.addEventListener('click', () => select(row));
			item.append(button);
			return item;
		}

		function suggest() {
			const query = input.value.trim();
			clear.classList.toggle('hidden', !input.value);
			clear.classList.toggle('flex', Boolean(input.value));

			if (query.length < minimum) {
				close();
				return;
			}

			const hits = matches(query);
			list.replaceChildren();
			active = -1;

			if (!hits.length) {
				const item = document.createElement('li');
				item.className = 'px-2.5 py-3 text-sm leading-relaxed text-muted-foreground';
				item.textContent = text.emptyBody;
				list.append(item);
			} else {
				hits.forEach((row, index) => list.append(option(row, index)));
			}

			list.hidden = false;
			input.setAttribute('aria-expanded', 'true');
		}

		function select(row: Row) {
			const [label, portalHost, groupName, status] = row;

			name.textContent = label;
			badge.textContent = text.status[status].badge;
			badge.className = `mt-3 inline-flex items-center rounded-pill px-2.5 py-1 text-xs font-semibold ${text.tones[status]}`;
			body.textContent = text.status[status].body;

			portal.hidden = !portalHost;
			host.textContent = portalHost;

			group.hidden = !groupName;
			group.textContent = groupName ? text.groupNote.replace('{group}', groupName) : '';

			// A portal the app cannot sign in to is not a reason to send anybody to
			// the installer; the full entry, with what to do next, is.
			download.hidden = status === 'sso' || status === 'unknown';
			sheet.href = `${text.sheetHref}?q=${encodeURIComponent(label)}`;

			card.hidden = false;
			input.value = label;
			close();
		}

		input.addEventListener('input', () => {
			card.hidden = true;
			suggest();
		});

		input.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowDown') {
				event.preventDefault();
				move(1);
			} else if (event.key === 'ArrowUp') {
				event.preventDefault();
				move(-1);
			} else if (event.key === 'Enter') {
				const items = options();
				const target = active >= 0 ? items[active] : items[0];
				// Only take the key when there is something to take it for: with no
				// suggestion open, Enter stays the form's own submit.
				if (target) {
					event.preventDefault();
					target.click();
				}
			} else if (event.key === 'Escape') {
				close();
			}
		});

		input.addEventListener('blur', () => close());

		clear.addEventListener('click', () => {
			input.value = '';
			card.hidden = true;
			clear.classList.add('hidden');
			clear.classList.remove('flex');
			close();
			input.focus();
		});
	}
</script>
