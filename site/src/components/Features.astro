---
// Three alternating rows: copy and a screenshot, sides swapped each row. The
// screenshot is the proof, so it takes the wider column.
import Icon from './Icon.astro';
import { useContent, type Lang } from '../i18n/content';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useContent(lang);
---

<section id="features" class="mx-auto w-full max-w-[76rem] scroll-mt-24 px-5 py-20 sm:px-8 sm:py-28">
	<div class="space-y-24 sm:space-y-32">
		{
			t.features.map((feature, index) => (
				// The screenshot is the proof, so it keeps the wider column in both
				// directions: swapping the order alone would shrink every other one.
				<article
					class:list={[
						'grid items-center gap-10 lg:gap-16',
						index % 2 === 1
							? 'lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]'
							: 'lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]',
					]}
				>
					<div class={index % 2 === 1 ? 'lg:order-2' : undefined}>
						<h2 class="text-3xl font-heavy tracking-[-0.02em] text-foreground sm:text-4xl">{feature.title}</h2>
						<p class="mt-4 max-w-[48ch] text-lg leading-relaxed text-muted-foreground">{feature.body}</p>
						<ul class="mt-7 space-y-3.5">
							{feature.points.map((point) => (
								<li class="flex gap-3 text-md leading-relaxed text-foreground">
									<Icon name="check" class="mt-1 size-[1.125rem] shrink-0 text-primary-deep" strokeWidth={2.25} />
									<span>{point}</span>
								</li>
							))}
						</ul>
					</div>

					<figure class={index % 2 === 1 ? 'lg:order-1' : undefined}>
						<div class="device">
							<img
								src={`/media/${feature.image}`}
								alt={feature.alt}
								width="1280"
								height="800"
								loading="lazy"
								decoding="async"
							/>
						</div>
						<figcaption class="mt-3 text-sm text-muted-foreground">{t.demoNote}</figcaption>
					</figure>
				</article>
			))
		}
	</div>
</section>
