---
// The compatibility page: every school known to run Aimaira, what its portal
// address is, and what BetterAimaira can do with it.
//
// The whole list is rendered at build time and filtered in the browser. Nothing
// here is fetched: no portal is contacted, no query leaves the page, and a
// visitor with JavaScript off still gets all 129 schools — they just scroll.
//
// The four statuses are what a visitor actually came to ask, so they are said
// in words and never carried by colour alone.
import Button from './Button.astro';
import Icon from './Icon.astro';
import schools from '../../../assets/schools/schools.json';
import {
	localePath,
	useContent,
	type Lang,
	type PortalLogin,
	type SchoolStatus,
} from '../i18n/content';

interface Props {
	lang: Lang;
}

interface School {
	id: string;
	name: string;
	category: string;
	portalUrl: string | null;
	portalLogin: PortalLogin | null;
	group?: string;
	website?: string;
}

const { lang } = Astro.props;
const t = useContent(lang);
const directory = schools as School[];

function statusOf(school: School): SchoolStatus {
	if (!school.portalUrl) return 'unknown';
	if (school.portalLogin === 'sso') return 'sso';
	if (school.portalLogin === 'email-first') return 'emailFirst';
	return 'ready';
}

/** The badge tone per status. Never the only carrier — the label says it too. */
const statusTones: Record<SchoolStatus, string> = {
	ready: 'bg-success-surface text-success-strong',
	emailFirst: 'bg-muted text-primary-deep',
	sso: 'bg-danger-surface text-danger-strong',
	unknown: 'bg-surface-sunken text-muted-foreground',
};

const statusOrder: SchoolStatus[] = ['ready', 'emailFirst', 'sso', 'unknown'];

/** Accent-insensitive, so `ecole` finds `École` and `spéos` finds `Speos`. */
function fold(text: string): string {
	return text
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase();
}

const rows = directory.map((school) => ({
	school,
	status: statusOf(school),
	host: school.portalUrl?.replace(/^https:\/\//, '').replace(/\/$/, '') ?? null,
	haystack: fold(
		[school.name, school.group ?? '', school.id.replace(/-/g, ' '), school.portalUrl ?? '']
			.join(' ')
	),
}));

// Only the categories the list actually uses, in the reader's alphabet.
const categories = [...new Set(directory.map((school) => school.category))]
	.map((id) => ({ id, label: t.schools.categories[id] ?? id }))
	.sort((a, b) => a.label.localeCompare(b.label, lang));
---

<section class="mx-auto w-full max-w-[76rem] px-5 pt-16 sm:px-8 sm:pt-24">
	<div class="max-w-[48rem]">
		<h1 class="text-4xl font-heavy tracking-[-0.02em] text-foreground sm:text-5xl">
			{t.schools.title}
		</h1>
		<p class="mt-5 text-lg leading-relaxed text-muted-foreground">{t.schools.lead}</p>
	</div>

	<!-- The legend before the list, not after it: the badges below mean nothing
	     until these four sentences have been read once. -->
	<dl class="mt-10 grid gap-3 sm:grid-cols-2">
		{
			statusOrder.map((status) => (
				<div class="rounded-lg border border-border-subtle bg-card p-4">
					<dt>
						<span
							class={`inline-flex items-center rounded-pill px-2.5 py-1 text-xs font-semibold ${statusTones[status]}`}
						>
							{t.schools.status[status].badge}
						</span>
					</dt>
					<dd class="mt-2 text-md leading-relaxed text-muted-foreground">
						{t.schools.status[status].body}
					</dd>
				</div>
			))
		}
	</dl>
</section>

<section class="mx-auto w-full max-w-[76rem] px-5 pt-12 sm:px-8" data-schools>
	<div class="sticky top-16 z-20 -mx-5 bg-background/90 px-5 py-4 backdrop-blur-md sm:-mx-8 sm:px-8">
		<label class="block text-sm font-semibold text-foreground" for="school-search">
			{t.schools.searchLabel}
		</label>
		<div
			class="mt-2 flex min-h-[3.25rem] items-center rounded-md border border-border bg-card pl-3.5 text-muted-foreground focus-within:border-primary-deep"
		>
			<Icon name="search" class="size-[1.125rem] shrink-0" />
			<input
				id="school-search"
				type="search"
				autocomplete="off"
				autocapitalize="none"
				spellcheck="false"
				placeholder={t.schools.searchPlaceholder}
				class="min-w-0 flex-1 self-stretch bg-transparent px-3 text-md text-foreground outline-0 placeholder:text-muted-foreground"
				data-school-search
			/>
			<button
				type="button"
				class="mr-1 hidden size-(--tap-min) shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors duration-fast hover:bg-muted hover:text-foreground"
				aria-label={t.schools.clear}
				data-school-clear
			>
				<Icon name="x" class="size-[1.125rem]" />
			</button>
		</div>

		<div class="mt-3 flex flex-wrap items-center gap-2" role="group" aria-label={t.schools.filterLabel}>
			<button
				type="button"
				class="school-chip min-h-9 rounded-pill border border-border px-3 text-sm font-semibold text-muted-foreground transition-colors duration-fast hover:bg-muted aria-pressed:border-primary-deep aria-pressed:bg-primary-deep aria-pressed:text-white"
				aria-pressed="true"
				data-school-category="">{t.schools.filterAll}</button
			>
			{
				categories.map((category) => (
					<button
						type="button"
						class="school-chip min-h-9 rounded-pill border border-border px-3 text-sm font-semibold text-muted-foreground transition-colors duration-fast hover:bg-muted aria-pressed:border-primary-deep aria-pressed:bg-primary-deep aria-pressed:text-white"
						aria-pressed="false"
						data-school-category={category.id}
					>
						{category.label}
					</button>
				))
			}
		</div>

		<p
			class="mt-3 text-sm text-muted-foreground"
			aria-live="polite"
			data-school-count
			data-one={t.schools.countOne}
			data-other={t.schools.countOther}
		>
			{directory.length}
			{directory.length === 1 ? t.schools.countOne : t.schools.countOther}
		</p>
	</div>

	<ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-school-list>
		{
			rows.map((row) => (
				<li
					class="flex flex-col gap-3 rounded-lg border border-border-subtle bg-card p-4"
					data-school
					data-search={row.haystack}
					data-category={row.school.category}
				>
					<span class="flex h-14 w-full items-center justify-center rounded-md bg-white px-3">
						<img
							src={`/media/schools/${row.school.id}.webp`}
							alt=""
							width="240"
							height="120"
							loading="lazy"
							decoding="async"
							class="max-h-11 w-auto max-w-full object-contain"
						/>
					</span>

					<h2 class="text-md font-bold leading-snug text-foreground">{row.school.name}</h2>

					<span
						class={`inline-flex w-fit items-center rounded-pill px-2.5 py-1 text-xs font-semibold ${statusTones[row.status]}`}
					>
						{t.schools.status[row.status].badge}
					</span>

					{row.host && (
						<p class="min-w-0 text-sm">
							<span class="block text-xs font-semibold uppercase tracking-wide text-muted-foreground">
								{t.schools.portalLabel}
							</span>
							<span class="block break-all text-foreground" data-numeric>
								{row.host}
							</span>
						</p>
					)}

					{row.school.group && (
						<p class="text-sm text-muted-foreground">
							{t.schools.groupNote.replace('{group}', row.school.group)}
						</p>
					)}

					{row.school.website && (
						<a
							href={row.school.website}
							rel="noreferrer nofollow"
							target="_blank"
							class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-primary-deep no-underline hover:underline"
						>
							{t.schools.websiteLabel}
							<Icon name="external-link" class="size-3.5" />
						</a>
					)}
				</li>
			))
		}
	</ul>

	<div
		class="mt-6 hidden rounded-lg border border-border-subtle bg-card p-8 text-center"
		data-school-empty
	>
		<h2 class="text-xl font-bold text-foreground">{t.schools.emptyTitle}</h2>
		<p class="mx-auto mt-3 max-w-[46ch] text-md leading-relaxed text-muted-foreground">
			{t.schools.emptyBody}
		</p>
	</div>
</section>

<section class="mx-auto w-full max-w-[76rem] px-5 py-20 sm:px-8 sm:py-28">
	<div class="rounded-lg border border-border-subtle bg-card p-6 sm:p-8">
		<h2 class="text-2xl font-heavy tracking-[-0.02em] text-foreground">{t.schools.missingTitle}</h2>
		<p class="mt-4 max-w-[62ch] text-lg leading-relaxed text-muted-foreground">
			{t.schools.missingBody}
		</p>
		<div class="mt-6">
			<Button href={localePath(lang, 'download')} variant="accent" size="lg" icon="download">
				{t.schools.cta}
			</Button>
		</div>
	</div>
	<p class="mt-6 max-w-[62ch] text-sm leading-relaxed text-muted-foreground">
		{t.schools.sourceNote}
	</p>
</section>

<style>
	/* WebKit draws its own clear button inside a search field, next to the one
	   this page draws with a label on it. Two crosses, one job. */
	input[type='search']::-webkit-search-cancel-button {
		display: none;
	}
</style>

<script>
	// Plain DOM filtering over the server-rendered list. No framework, no fetch,
	// no index: 129 nodes is small enough that hiding them one by one on every
	// keystroke is imperceptible, and the page keeps working with the script
	// stripped out — it just shows everything.
	const root = document.querySelector<HTMLElement>('[data-schools]');

	if (root) {
		const search = root.querySelector<HTMLInputElement>('[data-school-search]');
		const clear = root.querySelector<HTMLButtonElement>('[data-school-clear]');
		const count = root.querySelector<HTMLElement>('[data-school-count]');
		const empty = root.querySelector<HTMLElement>('[data-school-empty]');
		const list = root.querySelector<HTMLElement>('[data-school-list]');
		const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-school-category]')];
		const cards = [...root.querySelectorAll<HTMLElement>('[data-school]')];
		const one = count?.dataset.one ?? '';
		const other = count?.dataset.other ?? '';

		let category = '';

		// `?q=` is how the home page check hands a school over, and how a filtered
		// list can be linked to at all. Only read on load: rewriting it on every
		// keystroke would fill the back button with half-typed names.
		const requested = new URLSearchParams(location.search).get('q');
		if (search && requested) search.value = requested;

		const fold = (text: string) =>
			text
				.normalize('NFD')
				.replace(/[̀-ͯ]/g, '')
				.toLowerCase();

		function apply() {
			const words = fold(search?.value ?? '')
				.split(/\s+/)
				.filter(Boolean);
			let shown = 0;

			for (const card of cards) {
				const haystack = card.dataset.search ?? '';
				const matches =
					(category === '' || card.dataset.category === category) &&
					words.every((word) => haystack.includes(word));
				card.hidden = !matches;
				if (matches) shown += 1;
			}

			if (count) count.textContent = `${shown} ${shown === 1 ? one : other}`;
			empty?.classList.toggle('hidden', shown > 0);
			list?.classList.toggle('hidden', shown === 0);
			clear?.classList.toggle('hidden', !search?.value);
			clear?.classList.toggle('flex', Boolean(search?.value));
		}

		search?.addEventListener('input', apply);
		clear?.addEventListener('click', () => {
			if (!search) return;
			search.value = '';
			search.focus();
			apply();
		});

		for (const chip of chips) {
			chip.addEventListener('click', () => {
				category = chip.dataset.schoolCategory ?? '';
				for (const candidate of chips) {
					candidate.setAttribute('aria-pressed', String(candidate === chip));
				}
				apply();
			});
		}

		apply();
	}
</script>
