---
// Sticky header. The nav links are in-page anchors on the home page and
// absolute links back to it from /download, so the header behaves the same on
// both pages without a second component.
//
// Below `md` the inline links collapse into a disclosure menu rather than
// vanishing: a 9600px page with no in-page navigation is not a simplification.
// The locale control moves inside that menu too, because at 390 the bar has
// 350px of content box and the lockup, a menu button, a locale control and the
// Download button do not fit — and a tap target may never be the thing that
// gives.
import Button from './Button.astro';
import Lockup from './Lockup.astro';
import Icon from './Icon.astro';
import { languages, localePath, repo, useContent, type Lang, type PageId } from '../i18n/content';

interface Props {
	lang: Lang;
	/** The page being read, so the language switch lands on its twin. */
	page: PageId;
}

const { lang, page } = Astro.props;
const t = useContent(lang);
const home = localePath(lang);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const docs = `${repo}/blob/master/docs/README.md`;

// In-page anchors on the home page, absolute links back to it from anywhere
// else. The schools page is a page of its own, so it is not one of them.
const sections = [
	{ href: `${home}#features`, label: t.nav.features },
	{ href: `${home}#privacy`, label: t.nav.privacy },
	{ href: `${home}#faq`, label: t.nav.faq },
	{ href: localePath(lang, 'schools'), label: t.nav.schools },
];
---

<a
	href="#main"
	class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:left-4 focus-visible:top-4 focus-visible:z-50 focus-visible:rounded-md focus-visible:bg-secondary focus-visible:px-4 focus-visible:py-2 focus-visible:text-md focus-visible:font-semibold focus-visible:text-secondary-foreground"
>
	{t.nav.skip}
</a>

<header class="sticky top-0 z-30 border-b border-border-subtle bg-background/85 backdrop-blur-md">
	<div class="mx-auto flex h-16 w-full max-w-[76rem] items-center gap-2 px-5 sm:gap-3 sm:px-8">
		<a
			href={home}
			class="flex min-h-(--tap-min) shrink-0 items-center rounded-sm no-underline"
			aria-label={`BetterAimaira — ${t.nav.home}`}
		>
			<Lockup />
		</a>

		<nav class="ml-auto hidden items-center gap-1 md:flex" aria-label={t.nav.menuLabel}>
			{
				sections.map((item) => (
					<a
						href={item.href}
						class="inline-flex min-h-(--tap-min) items-center rounded-sm px-3 text-md font-medium text-muted-foreground no-underline transition-colors duration-fast hover:text-foreground"
					>
						{item.label}
					</a>
				))
			}
			<a
				href={docs}
				rel="noreferrer"
				target="_blank"
				class="hidden min-h-(--tap-min) items-center gap-1.5 rounded-sm px-3 text-md font-medium text-muted-foreground no-underline transition-colors duration-fast hover:text-foreground lg:inline-flex"
			>
				{t.nav.docs}
				<Icon name="external-link" class="size-3.5" />
			</a>
		</nav>

		<div class="ml-auto flex items-center gap-2 md:ml-2">
			<a
				href={localePath(other, page)}
				hreflang={other}
				class="hidden min-h-(--tap-min) min-w-(--tap-min) items-center justify-center gap-1.5 rounded-md px-2.5 text-md font-semibold text-muted-foreground no-underline transition-colors duration-fast hover:bg-muted hover:text-foreground md:inline-flex"
				aria-label={`${t.nav.languageLabel}: ${languages[other]}`}
			>
				<Icon name="languages" class="size-[1.125rem]" />
				<span class="uppercase">{other}</span>
			</a>

			<Button href={localePath(lang, 'download')} variant="ink" icon="download">
				{t.nav.download}
			</Button>

			<details class="group relative md:hidden" data-nav-menu>
				<summary
					class="flex min-h-(--tap-min) min-w-(--tap-min) cursor-pointer list-none items-center justify-center rounded-md text-foreground transition-colors duration-fast hover:bg-muted"
					aria-label={t.nav.menuLabel}
				>
					<Icon name="menu" class="size-5 group-open:hidden" />
					<Icon name="x" class="hidden size-5 group-open:block" />
				</summary>

				<div
					class="absolute right-0 top-full z-40 mt-2 w-60 rounded-lg border border-border-subtle bg-card p-2 shadow-lg"
				>
					<nav aria-label={t.nav.menuLabel}>
						{
							sections.map((item) => (
								<a
									href={item.href}
									class="flex min-h-(--tap-min) items-center rounded-md px-3 text-md font-medium text-foreground no-underline transition-colors duration-fast hover:bg-muted"
								>
									{item.label}
								</a>
							))
						}
						<a
							href={docs}
							rel="noreferrer"
							target="_blank"
							class="flex min-h-(--tap-min) items-center gap-1.5 rounded-md px-3 text-md font-medium text-foreground no-underline transition-colors duration-fast hover:bg-muted"
						>
							{t.nav.docs}
							<Icon name="external-link" class="size-3.5 text-muted-foreground" />
						</a>
						<a
							href={localePath(other, page)}
							hreflang={other}
							class="mt-1 flex min-h-(--tap-min) items-center gap-2 rounded-md border-t border-border-subtle px-3 pt-1 text-md font-semibold text-foreground no-underline transition-colors duration-fast hover:bg-muted"
						>
							<Icon name="languages" class="size-[1.125rem] text-muted-foreground" />
							{languages[other]}
						</a>
					</nav>
				</div>
			</details>
		</div>
	</div>
</header>

<style>
	/* Safari draws its own disclosure triangle without this. */
	summary::-webkit-details-marker {
		display: none;
	}
</style>

<script>
	// A same-page anchor leaves the panel open over the section it just jumped
	// to, and Escape is what a reader expects to close an open menu.
	const menu = document.querySelector<HTMLDetailsElement>('[data-nav-menu]');

	if (menu) {
		for (const link of menu.querySelectorAll('a')) {
			link.addEventListener('click', () => {
				menu.open = false;
			});
		}

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.open) {
				menu.open = false;
				menu.querySelector('summary')?.focus();
			}
		});

		document.addEventListener('click', (event) => {
			if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
				menu.open = false;
			}
		});
	}
</script>
