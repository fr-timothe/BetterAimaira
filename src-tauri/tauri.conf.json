{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "BetterAimaira",
	"version": "0.1.1-beta.12",
	"identifier": "com.betteraimaira.app",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../build"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "BetterAimaira",
				"width": 1280,
				"height": 800,
				"minWidth": 680,
				"minHeight": 580,
				"decorations": false,
				"transparent": false,
				"shadow": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"createUpdaterArtifacts": true,
		"android": {
			"versionCode": 10112
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3MTgxRDFFQzlFMkU5QQpSV1NhTHA3czBZRnhCVS9BTVlxZWx1QUdTdkxLMXVWb3Vma0ZjMmVxWXNwWWZjejRRdVhTZm5jRwo=",
			"endpoints": ["https://betteraimaira.montfrond.work/updates/stable/latest.json"],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
