<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. The app ships a single light palette, so the
         theme states it outright: a DayNight parent would let the system hand
         the window a dark configuration the stylesheet never answers, and the
         status bar would keep drawing white glyphs over a white surface. -->
    <style name="Theme.betteraimaira" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
